# All application services bind to loopback by default.
SKILLSCOUT_DB_PATH=data/skillscout.db
SKILLSCOUT_SEED_DEMO=true
# The launcher creates a private persistent key in .local/agent.key if omitted.
# SKILLSCOUT_AGENT_KEY=replace-with-a-long-random-secret
SKILLSCOUT_SCHEDULER_ENABLED=true
SKILLSCOUT_SCHEDULER_MINUTES=60
# Set true only behind HTTPS in a real deployment.
SKILLSCOUT_SECURE_COOKIE=false

# Local inference. No paid keys are used. A model must be downloaded once.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
